{
  "name": "dashboardv2-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard de SOLO CONSULTAS (transacciones por máquina) sobre Api_DashboardV2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "start:api": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "start:api:prod": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.prod.conf.json",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "preview": "npm run build:demo && node tools/serve-dist.mjs 4200",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit",
    "build:demo": "ng build --configuration demo",
    "smoke": "esbuild scripts/smoke.mjs --bundle --platform=node --format=esm --outfile=dist/smoke.mjs --log-level=warning && node dist/smoke.mjs"
  },
  "dependencies": {
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "chart.js": "^4.4.7",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.14",
    "@angular/cli": "^18.2.14",
    "@angular/compiler-cli": "^18.2.13",
    "@types/jasmine": "~5.1.5",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.23.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.5.4"
  }
}
